---
// Server-rendered KaTeX. <Eq tex="..." /> inline, <Eq tex="..." display /> for a display block.
import katex from "katex";
interface Props { tex: string; display?: boolean }
const { tex, display = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: display, throwOnError: true, strict: "ignore" });
---
{display ? <div class="eq" set:html={html} /> : <span class="eq-inline" set:html={html} />}
